<div class="d-flex flex-column justify-content-between h-100">
  <div class="p-4">
    <%= render(layout: 'entries/entry_name', locals: { entry: entry }) do %>
    <div id="entry-name" class="d-flex align-items-center justify-content-between flex-grow-1">
      <%= turbo_frame_tag(:entry_name, class: 'w-100') do %>
        <h1 class="mb-0"><%= entry.name %></h1>
      <%end%>
      <div class="dropdown">
        <button class="btn btn-outline-light border-0 text-dark me-3" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-three-dots-vertical"></i>
        </button>
        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
          <li>
            <%= link_to(edit_entry_path(entry, input: :entry_name), data: { turbo_frame: :entry_name }, class: 'dropdown-item') do %>
              <i class="bi bi-pencil-square"></i> Edit Name
            <% end %>
          </li>
          <li>
            <%=  link_to(entry_path(entry), data: { turbo_method: :delete }, class: 'dropdown-item text-danger') do %>
              <i class="bi bi-trash3-fill"></i> Delete Entry
            <% end %>
          </li>
        </ul>
      </div>
    </div>
    <% end %>
    <div class="mt-5">
      <ul class="list-group">
        <h5 class="fw-bold">Credentials</h5>
        <li id="entry-username" class="list-group-item mt-2">
          <%= turbo_frame_tag(:entry_username) do %>
            <div class="d-flex justify-content-between align-items-center">
              <div class="form-floating w-100 d-flex align-items-center">
                <span class="me-5">Username</span>
                <%= text_field_tag(:username, entry.username, readonly: true, class: "form-control-plaintext p-0", placeholder: 'email') %>
              </div>
              <div class="actions d-flex">
                <button
                  class="btn btn-outline-primary border-0"
                  data-controller="clipboard"
                  data-action="click->clipboard#copy"
                  data-clipboard-content-param="<%= entry.username %>"
                >
                  <i class="bi bi-clipboard-plus"></i>
                </button>
                <%= link_to(edit_entry_path(entry, input: :entry_username), class: 'btn btn-outline-light border-0 text-dark') do %>
                  <i class="bi bi-pencil-square"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </li>

        <li id="entry-password" class="list-group-item" data-controller="toggle-password">
          <%= turbo_frame_tag(:entry_password) do %>
            <div class="d-flex justify-content-between align-items-center">
              <div class="form-floating w-100 d-flex align-items-center">
                <span class="me-5">Password</span>

                <%= text_field_tag(
                  :password,
                  entry.password,
                  type: :password,
                  readonly: true,
                  class: "form-control-plaintext",
                  placeholder: 'email',
                  data: { toggle_password_target: 'input' })
                %>
              </div>
              <div class="actions d-flex">
                <button
                  class="btn btn-outline-primary border-0"
                  data-action="click->toggle-password#toggle"
                >
                  <i class="biu bi-eye"></i>
                </button>
                <button
                  class="btn btn-outline-primary border-0"
                  data-controller="clipboard"
                  data-action="click->clipboard#copy"
                  data-clipboard-content-param="<%= entry.password %>"
                >
                  <i class="bi bi-clipboard-plus"></i>
                </button>
                <%= link_to(edit_entry_path(entry, input: :entry_password), class: 'btn btn-outline-light border-0 text-dark') do %>
                  <i class="bi bi-pencil-square"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </li>

        <li id="entry-url" class="list-group-item">
          <%= turbo_frame_tag(:entry_url) do %>
            <div class="d-flex justify-content-between align-items-center">
              <div class="form-floating w-100 d-flex align-items-center">
                <span class="me-5">URL</span>
                <%= link_to(entry.url, target: :_blank, rel: 'noopener noreferrer') do %>
                  <%= entry.url %> <i class="bi bi-box-arrow-up-right ms-1"></i>
                <% end %>
              </div>
              <div class="actions d-flex">
                <%= link_to(entry.url, target: :_blank, rel: 'noopener noreferrer', class: 'btn btn-outline-primary border-0') do %>
                  <i class="bi bi-box-arrow-up-right"></i>
                <% end %>
                <%= link_to(edit_entry_path(entry, input: :entry_url), class: 'btn btn-outline-light border-0 text-dark') do %>
                  <i class="bi bi-pencil-square"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </li>

        <hr>

       <div class="border border-light-subtle rounded-3 p-2">
          <table class="table table-borderless m-0">
            <tbody>
              <tr class="">
                <td>URL</td>
                <td>
                  <%= turbo_frame_tag(:entry_url) do %>
                    <div class="d-flex justify-content-between align-items-center">
                      <div class="form-floating w-100 d-flex align-items-center">
                        <%= link_to(entry.url, target: :_blank, rel: 'noopener noreferrer') do %>
                          <%= entry.url %>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </td>
                <td class="actions flex-end">
                  <%= link_to(entry.url, target: :_blank, rel: 'noopener noreferrer', class: 'btn btn-outline-primary border-0') do %>
                    <i class="bi bi-box-arrow-up-right"></i>
                  <% end %>
                  <%= link_to(edit_entry_path(entry, input: :entry_url), class: 'btn btn-outline-light border-0 text-dark') do %>
                    <i class="bi bi-pencil-square"></i>
                  <% end %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>


        <h5 class="fw-bold mt-5">Metadata</h5>
        <div class="border border-light-subtle rounded-3 p-2">
          <table class="table table-borderless m-0">
            <tbody>
              <tr>
                <td>Created</td>
                <td><%= format_time(entry.created_at) %></td>
              </tr>
              <tr>
                <td>Last modified</td>
                <td><%= format_time(entry.updated_at) %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </ul>
    </div>
  </div>
</div>
