<%= turbo_frame_tag("main-dashboard") do %>
  <div class="container d-flex align-items-center justify-content-between p-4 mt-4">
    <h1>Add password</h1>
    <%= link_to('Cancel', entries_path, class: 'btn btn-sm btn-outline-danger')%>
  </div>
  <div class="row">
    <div class="col">
      <div class="card m-3 border-0 shadow-sm">
        <div class="card-body">
          <% if @entry.errors.any? %>
            <div id="error_explanation" class="alert alert-danger">
              <h4>
                Please fix the <%= pluralize(@entry.errors.count, 'error') %>
                bellow and try again
              </h4>
              <ul>
                <% @entry.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <%= form_with(model: @entry) do |form| %>
            <div class="form-floating mb-3">
              <%= form.text_field(:name, placeholder: "Name", class: "form-control") %>
              <%= form.label(:name) %>
            </div>
            <div class="form-floating mb-3">
              <%= form.text_field(:url, placeholder: "URL", class: "form-control") %>
              <%= form.label(:url) %>
            </div>
            <div class="form-floating mb-3">
              <%= form.text_field(:username, placeholder: "Username", class: "form-control") %>
              <%= form.label(:username) %>
            </div>
            <div class="form-floating mb-3">
              <%= form.text_field(:password, placeholder: "Password", class: "form-control") %>
              <%= form.label(:password) %>
            </div>
            <%= form.submit('Save', class: 'btn btn-brand') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
