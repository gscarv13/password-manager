<%= link_to( entry_path(entry), class: "d-flex flex-column text-decoration-none border-bottom", data: {turbo_frame: 'main-dashboard'}, id: dom_id(entry)) do %>
  <%= render(layout: 'entries/entry_name', locals: { entry: entry }) do  %>
    <div class="d-flex flex-column justify-content-center">
      <p class="text-dark m-0"><%= entry.name %></p>
      <span class="text-body-tertiary"><%= entry.username %></span>
    </div>
  <% end %>
<% end %>
